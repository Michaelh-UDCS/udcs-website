# Client-side environment variables must be prefixed with VITE_
# VITE_EXAMPLE_KEY=your_public_key_here

# GA4 — leave empty until a real measurement ID is set in siteConfig / .env
VITE_GA4_MEASUREMENT_ID=

# Backend/Private environment variables (DO NOT prefix with VITE_)
# SECRETS SHOULD NOT BE COMMITTED TO THE REPOSITORY
GEMINI_API_KEY=
